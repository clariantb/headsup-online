# Game server port
PORT=3001

# LiveKit (video/audio). Leave blank to play without video.
# Local dev server: docker compose up livekit  ->  ws://localhost:7880 / devkey / secret
# LiveKit Cloud: https://cloud.livekit.io (free tier)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
